# ComeBack RAG service — copy to `.env` and fill in.

# --- Supabase (same project as the app) ---
# Public URL + anon key, identical to the mobile app's values.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...replace-me...

# Service-role key is ONLY used by the offline exercise-KB ingest script
# (curated, non-user data). The request path never touches it. Keep it secret;
# never ship it to the mobile client. Leave blank if you won't run ingest here.
SUPABASE_SERVICE_ROLE_KEY=

# Every request's user token is verified BEFORE any Gemini spend. If this is set
# (Supabase → Settings → API → JWT Secret, HS256 projects only) verification is a
# local signature check with no network hop. If blank, the service asks Supabase
# Auth (GET /auth/v1/user) instead — slower by one round-trip, but works for every
# project including those on asymmetric signing keys. Either way an invalid token
# is a 401 that costs nothing.
SUPABASE_JWT_SECRET=

# --- Gemini ---
# Server-side key for embeddings + generation. Separate from the app's key.
GEMINI_API_KEY=AIza...replace-me...
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Retrieval defaults ---
RAG_KB_TOP_K=5
RAG_MEMORY_TOP_K=5
RAG_MIN_SIMILARITY=0.35

# --- Service ---
# Comma-separated origins allowed to call the API (your Expo dev origin, etc.).
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=INFO
# Per-user ceiling on paid requests (each one embeds and usually generates on the
# key above). Sliding window per uvicorn worker; 0 disables. 429 + Retry-After.
RAG_RATE_LIMIT_PER_MINUTE=30
